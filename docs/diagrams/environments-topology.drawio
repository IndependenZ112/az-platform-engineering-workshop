        <mxCell id="prod-mon" value="appi-hotelbooking-prod-swedencentral-001&#10;(Application Insights isn't available in Belgium Central yet —&#10;same Sweden Central fallback as test's; public endpoint, no private coupling)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="810" y="555" width="440" height="80" as="geometry" />
        </mxCell>
        <mxCell id="prod-scale" value="≥ 3 replicas always on, spread across 3 availability zones · never scales to zero" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="810" y="645" width="440" height="35" as="geometry" />
        </mxCell>

        <!-- Peerings -->
        <mxCell id="e-test-hub" value="peered (bidirectional)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6c8ebf;strokeWidth=2;html=1;" edge="1" parent="1" source="test" target="hub">
