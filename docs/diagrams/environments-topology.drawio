        <mxCell id="e-no-peer" value="NOT peered — no network path between environments" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#b85450;strokeWidth=2;dashed=1;html=1;startArrow=none;endArrow=none;" edge="1" parent="1" source="test" target="prod">
