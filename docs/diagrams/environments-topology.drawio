        <!-- Prod spoke -->
        <mxCell id="prod" value="PROD — rg-hotelbooking-prod-belgiumcentral&#10;Belgium Central (same region as test)&#10;vnet-hotelbooking-prod-belgiumcentral-001&#10;192.168.102.0/24" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="800" y="280" width="460" height="420" as="geometry" />
