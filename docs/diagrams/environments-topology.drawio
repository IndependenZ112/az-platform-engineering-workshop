        <mxCell id="e-prod-hub" value="peered (bidirectional)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6c8ebf;strokeWidth=2;html=1;" edge="1" parent="1" source="prod" target="hub">
          <mxGeometry relative="1" as="geometry" />
