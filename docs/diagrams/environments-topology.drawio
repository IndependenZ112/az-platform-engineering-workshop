        <mxCell id="hub" value="Hub — rg-platform — Sweden Central&#10;vnet-hub 192.168.100.0/24&#10;(unchanged by this chore)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="80" width="320" height="100" as="geometry" />
