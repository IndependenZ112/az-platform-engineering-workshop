        <!-- Test spoke -->
        <mxCell id="test" value="TEST — rg-hotelbooking-test-belgiumcentral&#10;Belgium Central&#10;vnet-hotelbooking-test-belgiumcentral-001&#10;192.168.101.0/24" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="140" y="280" width="460" height="420" as="geometry" />
        </mxCell>
        <mxCell id="test-detail" value="cae-hotelbooking-test-belgiumcentral-001 (Consumption, zoneRedundant: false)&#10;ca-hotelweb-test-belgiumcentral — external — min 0 / max 3&#10;ca-hotelapi-test-belgiumcentral — internal — min 0 / max 3&#10;sql-hotelbooking-test-belgiumcentral-… — GP_S_Gen5 ×1, zoneRedundant: false, autoPause 60 min&#10;id-hotelapi-test-belgiumcentral-001 (runtime) = SQL Entra admin&#10;id-cicd-hotelbooking-test-belgiumcentral-001 (CI/CD, Contributor on this RG)&#10;privatelink.database.windows.net (own zone, linked to this spoke + hub)&#10;log-hotelbooking-test-belgiumcentral-001 (Log Analytics)" style="text;html=1;align=left;verticalAlign=top;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="150" y="375" width="440" height="170" as="geometry" />
