        <mxCell id="note" value="Same infra/workload/main.bicep for both — every difference above is a parameter value (main.test.bicepparam / main.prod.bicepparam), never an environment if-branch." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
